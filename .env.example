# Copy to backend/.env for local development. Never commit real values.

APP_ENV=local
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+psycopg://agrosnap:agrosnap@localhost:5432/agrosnap

# Auth
JWT_SECRET=change-me-to-a-long-random-value
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# Model (bundle exported by the v3 notebook §14: model.tflite or model.keras + model_meta.json + class_mapping.json)
# For app development before training: DEMO_MODEL=true and CLASS_MAPPING_PATH=demo/class_mapping.json
DEMO_MODEL=false
MODEL_META_PATH=../ml/artifacts/model_meta.json
MODEL_PATH=../ml/artifacts/model.tflite
MODEL_VERSION=
MODEL_SHA256=
CLASS_MAPPING_PATH=../ml/artifacts/class_mapping.json
UNCERTAINTY_T_CONF=
UNCERTAINTY_M_MIN=
MAX_UPLOAD_MB=8
INFERENCE_MAX_CONCURRENCY=2

# Object storage (S3-compatible; MinIO locally)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=agrosnap-scans
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
SIGNED_URL_TTL_SEC=300

# Weather (server-side only)
WEATHER_PROVIDER=
WEATHER_API_KEY=
WEATHER_CACHE_TTL_MIN=20

# Optional
RATE_LIMIT_STORAGE_URL=
SENTRY_DSN=

# ---- Mobile (mobile/.env) — public values only, visible in the APK ----
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:8000/api/v1
